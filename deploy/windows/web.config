<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS — AeroTeam : site statique + reverse proxy PostgREST
     À placer à la racine du site (C:\AeroTeam\www\web.config).
     Prérequis : modules URL Rewrite 2.1 + Application Request Routing 3.0
     (ARR : activer « Enable proxy »). -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- API : /rest/v1/... → PostgREST sur localhost:3000 -->
        <rule name="PostgREST" stopProcessing="true">
          <match url="^rest/v1/(.*)" />
          <action type="Rewrite" url="http://localhost:3000/{R:1}" />
        </rule>
        <!-- Application React (SPA) : tout le reste → index.html -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- Le service worker doit toujours être servi frais -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
